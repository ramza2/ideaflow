# Docker Compose
COMPOSE_PROJECT_NAME=ideaflow

# Deployment mode
# direct  = host port (:8080)
# traefik = existing external Traefik network
IDEAFLOW_DEPLOY_MODE=direct

IDEAFLOW_BIND_ADDRESS=0.0.0.0
IDEAFLOW_HTTP_PORT=8080

# Used only when IDEAFLOW_DEPLOY_MODE=traefik
IDEAFLOW_HOST=CHANGE_ME_IDEAFLOW_HOST
IDEAFLOW_PUBLIC_URL=https://CHANGE_ME_IDEAFLOW_HOST
TRAEFIK_NETWORK=CHANGE_ME_TRAEFIK_NETWORK
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true

# Application
APP_ENV=production
APP_NAME=IdeaFlow API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Browser origin (comma-separated; no wildcard with credentials)
CORS_ORIGINS=http://localhost:8080

# PostgreSQL
POSTGRES_DB=ideaflow
POSTGRES_USER=ideaflow
POSTGRES_PASSWORD=CHANGE_ME_USE_LONG_RANDOM_PASSWORD

DATABASE_URL=postgresql+psycopg://ideaflow:CHANGE_ME_USE_LONG_RANDOM_PASSWORD@db:5432/ideaflow

# Auth
AUTH_SESSION_COOKIE_NAME=ideaflow_session
AUTH_CSRF_COOKIE_NAME=ideaflow_csrf

AUTH_SESSION_IDLE_SECONDS=604800
AUTH_SESSION_ABSOLUTE_SECONDS=2592000
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=900

AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_SECONDS=900

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# LLM
LLM_API_URL=https://alzi-llm.openlink.kr
LLM_API_KEY=
LLM_MODEL_NAME=Qwen3-14B
LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions

LLM_TIMEOUT_SECONDS=120
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500
LLM_ENABLE_THINKING=false

# AI Worker
AI_WORKER_ENABLED=true
AI_JOB_POLL_INTERVAL_SECONDS=1
AI_JOB_LEASE_SECONDS=300
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_BASE_SECONDS=2

# Web Search
WEB_SEARCH_PROVIDER=http_json
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=

WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_CONNECT_TIMEOUT_SECONDS=5
WEB_SEARCH_MAX_QUERIES=5
WEB_SEARCH_MAX_RESULTS_PER_QUERY=5
WEB_SEARCH_MAX_TOTAL_RESULTS=20

# Frontend build (build-time only; baked into static bundle)
VITE_API_BASE_URL=/api/v1
VITE_AUTH_CSRF_COOKIE_NAME=ideaflow_csrf
