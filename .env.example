# Application
APP_ENV=development
APP_NAME=IdeaFlow API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# CORS (comma-separated origins; do not use * with credentials)
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL — Step 2+)
# SQLAlchemy URL using the psycopg 3 driver
DATABASE_URL=postgresql+psycopg://ideaflow:ideaflow@localhost:5432/ideaflow

# Auth / Session (Step 3+)
AUTH_SESSION_COOKIE_NAME=ideaflow_session
AUTH_CSRF_COOKIE_NAME=ideaflow_csrf
AUTH_SESSION_IDLE_SECONDS=604800
AUTH_SESSION_ABSOLUTE_SECONDS=2592000
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=900
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# LLM (used in later steps)
LLM_API_URL=https://alzi-llm.openlink.kr
LLM_API_KEY=
LLM_MODEL_NAME=Qwen3-14B

# Web Search (used in later steps)
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
